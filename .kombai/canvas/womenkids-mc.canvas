ro-card\", { autoAlpha: 0, y: 40, filter: \"blur(10px)\", duration: 0.9, ease: \"power2.out\", delay: 0.15 });\n\n  // Hero image subtle parallax\n  gsap.to(\"#hero-img\", {\n    yPercent: -12, ease: \"none\",\n    scrollTrigger: { trigger: \"#hero-img\", start: \"top top\", end: \"bottom top\", scrub: true }\n  });\n\n  // Feature blocks reveal\n  gsap.utils.toArray(\".feature-block\").forEach((block) => {\n    gsap.from(block, {\n      autoAlpha: 0, y: 48, duration: 0.8, ease: \"power2.out\",\n      scrollTrigger: { trigger: block, start: \"top 80%\" }\n    });\n  });\n\n  // Ledger rows staggered reveal\n  gsap.set(\".ledger-row\", { autoAlpha: 0, y: 24 });\n  ScrollTrigger.batch(\".ledger-row\", {\n    start: \"top 88%\",\n    onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.08, ease: \"power2.out\", overwrite: true })\n  });\n\n  // Trust strip + CTA reveal\n  gsap.from(\"#trust-strip\", {\n    autoAlpha: 0, y: 30, duration: 0.7, ease: \"power2.out\",\n    scrollTrigger: { trigger: \"#trust-strip\", start: \"top 88%\" }\n  });\n  gsap.from(\"#cta-card\", {\n    autoAlpha: 0, y: 40, duration: 0.8, ease: \"power2.out\",\n    scrollTrigger: { trigger: \"#cta-card\", start: \"top 85%\" }\n  });\n</script>\n",
