      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');\n  .font-serif { font-family: 'Playfair Display', serif; }\n  .font-sans { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler icon font library\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"font-sans bg-[#FFF5EE] text-[#4A3B3B]\" data-kid=\"2\" data-name=\"page layout container\" style=\"overflow-x: clip;\">\n    <!-- Navbar -->\n    <header class=\"sticky top-0 z-50 bg-[#FFF5EE]/90 backdrop-blur-md border-b border-[#DE5D83]/10\" data-kid=\"2-1\" data-name=\"sticky navigation header\">\n        <div class=\"max-w-6xl mx-auto px-6 h-18 flex items-center justify-between\" data-kid=\"2-1-1\" data-name=\"navbar content container\">\n            <a class=\"flex items-center gap-2.5\" data-kid=\"2-1-1-1\" data-name=\"logo and brand link\" href=\"#\">\n                <span class=\"w-9 h-9 rounded-full bg-[#DE5D83] text-white flex items-center justify-center text-lg\" data-kid=\"2-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"ti ti-heart\" data-kid=\"2-1-1-1-1-1\" data-name=\"heart icon\">\n                    </i>\n                </span>\n                <span class=\"font-serif text-lg font-semibold tracking-wide text-[#3B2A2F]\" data-kid=\"2-1-1-1-2\" data-name=\"brand name text\">\n                    WOMEN&KIDS\n                    <span class=\"text-[#DE5D83]\" data-kid=\"2-1-1-1-2-1\" data-name=\"brand suffix text\">\n                        MC\n                    </span>\n                </span>\n            </a>\n            <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-[#6B5A5E]\" data-kid=\"2-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"hover:text-[#DE5D83] transition-colors\" data-kid=\"2-1-1-2-1\" data-name=\"navigation link home\" href=\"#\">\n                    Inicio\n                </a>\n                <a class=\"text-[#DE5D83] font-semibold\" data-kid=\"2-1-1-2-2\" data-name=\"navigation link services\" href=\"#\">\n                    Servicios\n                </a>\n                <a class=\"hover:text-[#DE5D83] transition-colors\" data-kid=\"2-1-1-2-3\" data-name=\"navigation link about\" href=\"#\">\n                    Sobre la Doctora\n                </a>\n                <a class=\"hover:text-[#DE5D83] transition-colors\" data-kid=\"2-1-1-2-4\" data-name=\"navigation link location\" href=\"#\">\n                    Ubicación\n                </a>\n                <a class=\"hover:text-[#DE5D83] transition-colors\" data-kid=\"2-1-1-2-5\" data-name=\"navigation link faq\" href=\"#\">\n                    FAQ\n                </a>\n            </nav>\n            <a class=\"inline-flex items-center gap-2 bg-[#DE5D83] text-white text-sm font-semibold px-5 py-2.5 rounded-full hover:bg-[#c94d72] transition-colors\" data-kid=\"2-1-1-3\" data-name=\"call-to-action schedule button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\">\n                Agendar cita\n                <i class=\"ti ti-arrow-up-right\" data-kid=\"2-1-1-3-1\" data-name=\"arrow-up-right icon\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <!-- Hero flush-top -->\n    <section class=\"relative\" data-kid=\"2-2\" data-name=\"hero section\">\n        <div class=\"h-[42vh] min-h-[340px] w-full overflow-hidden relative\" data-kid=\"2-2-1\" data-name=\"hero image background container\">\n            <img alt=\"Manos sosteniendo ultrasonido — Emine Gizem on Pexels\" class=\"w-full h-[120%] object-cover\" data-kid=\"2-2-1-1\" data-name=\"hero background image\" decoding=\"async\" id=\"hero-img\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35424756/pexels-photo-35424756.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\"/>\n            <div class=\"absolute inset-0 bg-gradient-to-t from-[#3B2A2F]/30 to-transparent\" data-kid=\"2-2-1-2\" data-name=\"hero image gradient overlay\">\n            </div>\n        </div>\n        <div class=\"max-w-5xl mx-auto px-6 -mt-24 relative z-10\" data-kid=\"2-2-2\" data-name=\"hero card wrapper\">\n            <div class=\"bg-white rounded-t-[2.5rem] rounded-b-xl px-8 md:px-14 pt-12 pb-10 border border-[#DE5D83]/10 shadow-[0_20px_60px_-30px_rgba(222,93,131,0.35)]\" data-kid=\"2-2-2-1\" data-name=\"hero information card\" id=\"hero-card\">\n                <div class=\"flex flex-col md:flex-row md:items-end gap-8 md:gap-14\" data-kid=\"2-2-2-1-1\" data-name=\"hero content layout container\">\n                    <div class=\"flex-1\" data-kid=\"2-2-2-1-1-1\" data-name=\"hero headline area\">\n                        <p class=\"text-xs font-semibold tracking-[0.25em] uppercase text-[#3AA8C1] mb-4\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"hero sub-headline\">\n                            Servicios · Ginecología y Obstetricia\n                        </p>\n                        <h1 class=\"font-serif text-4xl md:text-5xl leading-[1.1] text-[#3B2A2F]\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"main hero headline\">\n                            Cuidado Integral\n                            <em class=\"text-[#DE5D83]\" data-kid=\"2-2-2-1-1-1-2-1\" data-name=\"highlighted headline text\">\n                                para la Mujer\n                            </em>\n                        </h1>\n                    </div>\n                    <div class=\"md:max-w-xs md:pb-1\" data-kid=\"2-2-2-1-1-2\" data-name=\"hero secondary info area\">\n                        <p class=\"text-[15px] leading-relaxed text-[#6B5A5E]\" data-kid=\"2-2-2-1-1-2-1\" data-name=\"hero description text\">\n                            Desde el control prenatal hasta la menopausia: atención cálida, empática y basada en evidencia con la Dra. Ahidé Valeria García Muñoz.\n                        </p>\n                        <div class=\"mt-4 flex items-center gap-2 text-sm text-[#6B5A5E]\" data-kid=\"2-2-2-1-1-2-2\" data-name=\"hero social proof container\">\n                            <span class=\"text-[#DE5D83]\" data-kid=\"2-2-2-1-1-2-2-1\" data-name=\"star icon container\">\n                                <i class=\"ti ti-star-filled\" data-kid=\"2-2-2-1-1-2-2-1-1\" data-name=\"star icon\">\n                                </i>\n                            </span>\n                            <span class=\"font-semibold text-[#3B2A2F]\" data-kid=\"2-2-2-1-1-2-2-2\" data-name=\"review count text\">\n                                5.0\n                            </span>\n                            · 763+ opiniones en Doctoralia\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- Feature leads -->\n    <section class=\"max-w-6xl mx-auto px-6 pt-24 pb-8\" data-kid=\"2-3\" data-name=\"services features section\">\n        <!-- 01 Control Prenatal -->\n        <div class=\"feature-block grid md:grid-cols-12 gap-10 items-center mb-24\" data-kid=\"2-3-1\" data-name=\"control prenatal feature block\">\n            <div class=\"md:col-span-5 relative\" data-kid=\"2-3-1-1\" data-name=\"feature image container\">\n                <div class=\"absolute -top-6 -left-6 w-24 h-24 rounded-full bg-[#3AA8C1]/15 border border-[#3AA8C1]/30\" data-kid=\"2-3-1-1-1\" data-name=\"decorative circle background\">\n                </div>\n                <img alt=\"Mujer embarazada sonriendo tocando su vientre — Yan Krukau on Pexels\" class=\"relative w-full aspect-[4/5] object-cover rounded-[2rem] rounded-tr-[6rem] border border-white\" data-kid=\"2-3-1-1-2\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7155544/pexels-photo-7155544.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n            </div>\n            <div class=\"md:col-span-7 md:pl-6\" data-kid=\"2-3-1-2\" data-name=\"feature description area\">\n                <div class=\"flex items-baseline gap-4 mb-5\" data-kid=\"2-3-1-2-1\" data-name=\"feature header container\">\n                    <span class=\"font-serif text-5xl text-[#DE5D83]/30\" data-kid=\"2-3-1-2-1-1\" data-name=\"feature index number\">\n                        01\n                    </span>\n                    <span class=\"h-px flex-1 bg-[#DE5D83]/20\" data-kid=\"2-3-1-2-1-2\" data-name=\"horizontal rule\">\n                    </span>\n                    <span class=\"text-xs font-semibold tracking-[0.2em] uppercase text-[#3AA8C1]\" data-kid=\"2-3-1-2-1-3\" data-name=\"feature category label\">\n                        Obstetricia\n                    </span>\n                </div>\n                <h2 class=\"font-serif text-3xl md:text-4xl text-[#3B2A2F] mb-4 leading-tight\" data-kid=\"2-3-1-2-2\" data-name=\"feature title\">\n                    Control Prenatal y Embarazo de Alto y Bajo Riesgo\n                </h2>\n                <p class=\"text-[15px] leading-relaxed text-[#6B5A5E] mb-6 max-w-xl\" data-kid=\"2-3-1-2-3\" data-name=\"feature body text\">\n                    Acompañamiento experto en cada etapa de tu embarazo, con vigilancia personalizada y protocolos respaldados por la subespecialidad en Medicina Crítica Obstétrica. Tu tranquilidad y la salud de tu bebé son nuestra prioridad, desde la primera consulta hasta el nacimiento.\n                </p>\n                <ul class=\"space-y-2 text-sm text-[#6B5A5E]\" data-kid=\"2-3-1-2-4\" data-name=\"feature points list\">\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"2-3-1-2-4-1\" data-name=\"feature point\">\n                        <span class=\"text-[#3AA8C1]\" data-kid=\"2-3-1-2-4-1-1\" data-name=\"check icon container\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-3-1-2-4-1-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        Vigilancia especializada de embarazos de alto riesgo\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"2-3-1-2-4-2\" data-name=\"feature point\">\n                        <span class=\"text-[#3AA8C1]\" data-kid=\"2-3-1-2-4-2-1\" data-name=\"check icon container\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-3-1-2-4-2-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        Plan de control personalizado trimestre a trimestre\n                    </li>\n                </ul>\n            </div>\n        </div>\n        <!-- 02 Ultrasonido (reversed) -->\n        <div class=\"feature-block grid md:grid-cols-12 gap-10 items-center mb-24\" data-kid=\"2-3-2\" data-name=\"ultrasound feature block\">\n            <div class=\"md:col-span-7 md:pr-6 order-2 md:order-1\" data-kid=\"2-3-2-1\" data-name=\"feature description area\">\n                <div class=\"flex items-baseline gap-4 mb-5\" data-kid=\"2-3-2-1-1\" data-name=\"feature header container\">\n                    <span class=\"font-serif text-5xl text-[#3AA8C1]/30\" data-kid=\"2-3-2-1-1-1\" data-name=\"feature index number\">\n                        02\n                    </span>\n                    <span class=\"h-px flex-1 bg-[#3AA8C1]/20\" data-kid=\"2-3-2-1-1-2\" data-name=\"horizontal rule\">\n                    </span>\n                    <span class=\"text-xs font-semibold tracking-[0.2em] uppercase text-[#DE5D83]\" data-kid=\"2-3-2-1-1-3\" data-name=\"feature category label\">\n                        Diagnóstico\n                    </span>\n                </div>\n                <h2 class=\"font-serif text-3xl md:text-4xl text-[#3B2A2F] mb-4 leading-tight\" data-kid=\"2-3-2-1-2\" data-name=\"feature title\">\n                    Ultrasonido Obstétrico\n                </h2>\n                <p class=\"text-[15px] leading-relaxed text-[#6B5A5E] mb-6 max-w-xl\" data-kid=\"2-3-2-1-3\" data-name=\"feature body text\">\n                    Seguimiento puntual del desarrollo de tu bebé con equipo de ultrasonido actualizado. Cada estudio se realiza con calma y detalle, explicándote lo que observamos en pantalla para que vivas este momento con confianza y emoción.\n                </p>\n                <ul class=\"space-y-2 text-sm text-[#6B5A5E]\" data-kid=\"2-3-2-1-4\" data-name=\"feature points list\">\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"2-3-2-1-4-1\" data-name=\"feature point\">\n                        <span class=\"text-[#3AA8C1]\" data-kid=\"2-3-2-1-4-1-1\" data-name=\"check icon container\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-3-2-1-4-1-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        Valoración del crecimiento y bienestar fetal\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"2-3-2-1-4-2\" data-name=\"feature point\">\n                        <span class=\"text-[#3AA8C1]\" data-kid=\"2-3-2-1-4-2-1\" data-name=\"check icon container\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-3-2-1-4-2-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        Equipo médico moderno en Doctors Hospital East Auna\n                    </li>\n                </ul>\n                <div class=\"mt-7 inline-flex items-center gap-3 rounded-2xl bg-[#3AA8C1]/8 border border-[#3AA8C1]/15 px-5 py-3.5\" data-kid=\"2-3-2-1-5\" data-name=\"info highlight box\">\n                    <span class=\"text-[#3AA8C1] text-xl\" data-kid=\"2-3-2-1-5-1\" data-name=\"heart monitor icon container\">\n                        <i class=\"ti ti-device-heart-monitor\" data-kid=\"2-3-2-1-5-1-1\" data-name=\"heart monitor icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-sm text-[#4A6B74]\" data-kid=\"2-3-2-1-5-2\" data-name=\"highlight info text\">\n                        Cada ultrasonido incluye explicación detallada e impresión de imágenes para tu recuerdo.\n                    </p>\n                </div>\n            </div>\n            <div class=\"md:col-span-5 relative order-1 md:order-2\" data-kid=\"2-3-2-2\" data-name=\"feature image container\">\n                <div class=\"absolute -top-6 -right-6 w-24 h-24 rounded-full bg-[#DE5D83]/15 border border-[#DE5D83]/30\" data-kid=\"2-3-2-2-1\" data-name=\"decorative circle background\">\n                </div>\n                <img alt=\"Equipo digital de ultrasonido en consultorio — Pavel Danilyuk on Pexels\" class=\"relative w-full aspect-[4/5] object-cover rounded-[2rem] rounded-tl-[6rem] border border-white\" data-kid=\"2-3-2-2-2\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7108390/pexels-photo-7108390.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n            </div>\n        </div>\n        <!-- 03 Consulta Ginecológica -->\n        <div class=\"feature-block grid md:grid-cols-12 gap-10 items-center\" data-kid=\"2-3-3\" data-name=\"gynecology feature block\">\n            <div class=\"md:col-span-5 relative\" data-kid=\"2-3-3-1\" data-name=\"feature image container\">\n                <div class=\"absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-[#3AA8C1]/15 border border-[#3AA8C1]/30\" data-kid=\"2-3-3-1-1\" data-name=\"decorative circle background\">\n                </div>\n                <img alt=\"Consultorio con equipo de ultrasonido — MART PRODUCTION on Pexels\" class=\"relative w-full aspect-[4/5] object-cover rounded-[2rem] rounded-br-[6rem] border border-white\" data-kid=\"2-3-3-1-2\" data-name=\"feature image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7089029/pexels-photo-7089029.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n            </div>\n            <div class=\"md:col-span-7 md:pl-6\" data-kid=\"2-3-3-2\" data-name=\"feature description area\">\n                <div class=\"flex items-baseline gap-4 mb-5\" data-kid=\"2-3-3-2-1\" data-name=\"feature header container\">\n                    <span class=\"font-serif text-5xl text-[#DE5D83]/30\" data-kid=\"2-3-3-2-1-1\" data-name=\"feature index number\">\n                        03\n                    </span>\n                    <span class=\"h-px flex-1 bg-[#DE5D83]/20\" data-kid=\"2-3-3-2-1-2\" data-name=\"horizontal rule\">\n                    </span>\n                    <span class=\"text-xs font-semibold tracking-[0.2em] uppercase text-[#3AA8C1]\" data-kid=\"2-3-3-2-1-3\" data-name=\"feature category label\">\n                        Ginecología\n                    </span>\n                </div>\n                <h2 class=\"font-serif text-3xl md:text-4xl text-[#3B2A2F] mb-4 leading-tight\" data-kid=\"2-3-3-2-2\" data-name=\"feature title\">\n                    Consulta Ginecológica y Chequeo Anual\n                </h2>\n                <p class=\"text-[15px] leading-relaxed text-[#6B5A5E] mb-6 max-w-xl\" data-kid=\"2-3-3-2-3\" data-name=\"feature body text\">\n                    Prevención y salud integral en cada etapa de tu vida. Un espacio seguro, privado y sin prisas para resolver tus dudas, revisar tu salud ginecológica y construir juntas un plan de cuidado a tu medida.\n                </p>\n                <ul class=\"space-y-2 text-sm text-[#6B5A5E]\" data-kid=\"2-3-3-2-4\" data-name=\"feature points list\">\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"2-3-3-2-4-1\" data-name=\"feature point\">\n                        <span class=\"text-[#3AA8C1]\" data-kid=\"2-3-3-2-4-1-1\" data-name=\"check icon container\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-3-3-2-4-1-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        Revisión integral anual y seguimiento continuo\n                    </li>\n                    <li class=\"flex items-center gap-2.5\" data-kid=\"2-3-3-2-4-2\" data-name=\"feature point\">\n                        <span class=\"text-[#3AA8C1]\" data-kid=\"2-3-3-2-4-2-1\" data-name=\"check icon container\">\n                            <i class=\"ti ti-circle-check\" data-kid=\"2-3-3-2-4-2-1-1\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        Atención cálida, empática y basada en evidencia\n                    </li>\n                </ul>\n                <blockquote class=\"mt-7 relative pl-5 max-w-xl\" data-kid=\"2-3-3-2-5\" data-name=\"quote block\">\n                    <span class=\"absolute left-0 top-0 bottom-0 w-1 rounded-full bg-gradient-to-b from-[#DE5D83] to-[#3AA8C1]\" data-kid=\"2-3-3-2-5-1\" data-name=\"quote left accent\">\n                    </span>\n                    <p class=\"font-serif italic text-[17px] text-[#3B2A2F] leading-relaxed\" data-kid=\"2-3-3-2-5-2\" data-name=\"quote text\">\n                        “La prevención es el acto de amor más grande que puedes tener contigo misma.”\n                    </p>\n                    <p class=\"mt-2 text-xs font-semibold tracking-wide uppercase text-[#6B5A5E]\" data-kid=\"2-3-3-2-5-3\" data-name=\"quote author name\">\n                        Dra. Ahidé Valeria García Muñoz\n                    </p>\n                </blockquote>\n            </div>\n        </div>\n    </section>\n    <!-- Capability ledger -->\n    <section class=\"max-w-6xl mx-auto px-6 py-24\" data-kid=\"2-4\" data-name=\"capability ledger section\">\n        <div class=\"grid md:grid-cols-12 gap-10\" data-kid=\"2-4-1\" data-name=\"capability ledger container\">\n            <div class=\"md:col-span-4\" data-kid=\"2-4-1-1\" data-name=\"ledger sidebar header\">\n                <p class=\"text-xs font-semibold tracking-[0.25em] uppercase text-[#3AA8C1] mb-3\" data-kid=\"2-4-1-1-1\" data-name=\"ledger sub-header\">\n                    Cuidado de rutina\n                </p>\n                <h2 class=\"font-serif text-3xl md:text-4xl text-[#3B2A2F] leading-tight\" data-kid=\"2-4-1-1-2\" data-name=\"ledger title\">\n                    Prevención y bienestar,\n                    <em class=\"text-[#DE5D83]\" data-kid=\"2-4-1-1-2-1\" data-name=\"ledger title highlighted text\">\n                        cada día\n                    </em>\n                </h2>\n                <p class=\"mt-4 text-sm leading-relaxed text-[#6B5A5E] max-w-xs\" data-kid=\"2-4-1-1-3\" data-name=\"ledger description text\">\n                    Servicios esenciales para tu salud ginecológica, con la misma calidez y rigor médico en cada visita.\n                </p>\n            </div>\n            <div class=\"md:col-span-8\" data-kid=\"2-4-1-2\" data-name=\"ledger list container\">\n                <div class=\"border-t border-[#DE5D83]/20\" data-kid=\"2-4-1-2-1\" data-name=\"list border wrapper\">\n                    <div class=\"ledger-row grid grid-cols-[auto_1fr] md:grid-cols-[auto_1.2fr_1fr] items-center gap-x-6 gap-y-1 py-5 border-b border-[#DE5D83]/15\" data-kid=\"2-4-1-2-1-1\" data-name=\"ledger row 1\">\n                        <span class=\"w-10 h-10 rounded-full bg-[#DE5D83]/8 text-[#DE5D83] flex items-center justify-center text-lg\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"icon container\">\n                            <i class=\"ti ti-microscope\" data-kid=\"2-4-1-2-1-1-1-1\" data-name=\"microscope icon\">\n                            </i>\n                        </span>\n                        <h3 class=\"font-semibold text-[#3B2A2F] text-[15px]\" data-kid=\"2-4-1-2-1-1-2\" data-name=\"row title\">\n                            Papanicolaou y Detección Oportuna\n                        </h3>\n                        <p class=\"col-start-2 md:col-start-auto text-sm text-[#6B5A5E]\" data-kid=\"2-4-1-2-1-1-3\" data-name=\"row description\">\n                            Tamizaje puntual para detectar a tiempo y actuar con confianza.\n                        </p>\n                    </div>\n                    <div class=\"ledger-row grid grid-cols-[auto_1fr] md:grid-cols-[auto_1.2fr_1fr] items-center gap-x-6 gap-y-1 py-5 border-b border-[#DE5D83]/15\" data-kid=\"2-4-1-2-1-2\" data-name=\"ledger row 2\">\n                        <span class=\"w-10 h-10 rounded-full bg-[#3AA8C1]/10 text-[#3AA8C1] flex items-center justify-center text-lg\" data-kid=\"2-4-1-2-1-2-1\" data-name=\"icon container\">\n                            <i class=\"ti ti-vaccine\" data-kid=\"2-4-1-2-1-2-1-1\" data-name=\"vaccine icon\">\n                            </i>\n                        </span>\n                        <h3 class=\"font-semibold text-[#3B2A2F] text-[15px]\" data-kid=\"2-4-1-2-1-2-2\" data-name=\"row title\">\n                            Vacunación contra el VPH\n                        </h3>\n                        <p class=\"col-start-2 md:col-start-auto text-sm text-[#6B5A5E]\" data-kid=\"2-4-1-2-1-2-3\" data-name=\"row description\">\n                            Protección efectiva contra el virus del papiloma humano.\n                        </p>\n                    </div>\n                    <div class=\"ledger-row grid grid-cols-[auto_1fr] md:grid-cols-[auto_1.2fr_1fr] items-center gap-x-6 gap-y-1 py-5 border-b border-[#DE5D83]/15\" data-kid=\"2-4-1-2-1-3\" data-name=\"ledger row 3\">\n                        <span class=\"w-10 h-10 rounded-full bg-[#DE5D83]/8 text-[#DE5D83] flex items-center justify-center text-lg\" data-kid=\"2-4-1-2-1-3-1\" data-name=\"icon container\">\n                            <i class=\"ti ti-calendar-heart\" data-kid=\"2-4-1-2-1-3-1-1\" data-name=\"calendar-heart icon\">\n    