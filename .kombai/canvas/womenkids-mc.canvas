      "viewportScrollY": 0
    },
    "var_e4bdb7dea15b": {
      "type": "variant",
      "label": "WOMEN&KIDS MC — Contacto y Ubicación",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n.font-serif-d { font-family: 'Playfair Display', serif; }\n.font-body { font-family: 'Plus Jakarta Sans', sans-serif; }\n.nav-link { transition: color .2s ease; }\n</style>\n<div class=\"font-body bg-[#FFF5EE] text-[#3E2A33] overflow-x-clip\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- ═══════════ NAVBAR ═══════════ -->\n    <header class=\"sticky top-0 z-50 bg-[#FFF5EE]/85 backdrop-blur-md border-b border-[#DE5D83]/10\" data-kid=\"1-1\" data-name=\"navigation header\">\n        <div class=\"mx-auto max-w-7xl px-6 lg:px-10 h-20 flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"navbar inner container\">\n            <a class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n                <span class=\"grid h-11 w-11 place-items-center rounded-full bg-[#DE5D83] text-white text-xl shadow-[0_8px_20px_-6px_rgba(222,93,131,0.6)]\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"ti ti-heart-handshake\" data-kid=\"1-1-1-1-1-1\" data-name=\"handshake icon\">\n                    </i>\n                </span>\n                <span class=\"leading-tight\" data-kid=\"1-1-1-1-2\" data-name=\"brand text block\">\n                    <span class=\"block font-serif-d font-bold text-lg tracking-wide\" data-kid=\"1-1-1-1-2-1\" data-name=\"main brand name\">\n                        WOMEN\n                        <span class=\"text-[#DE5D83]\" data-kid=\"1-1-1-1-2-1-1\" data-name=\"ampersand symbol\">\n                            &\n                        </span>\n                        KIDS MC\n                    </span>\n                    <span class=\"block text-[10px] uppercase tracking-[0.24em] text-[#3AA8C1] font-bold\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle specialty\">\n                        Ginecología y Obstetricia\n                    </span>\n                </span>\n            </a>\n            <nav class=\"hidden lg:flex items-center gap-8 text-sm font-semibold text-[#3E2A33]/70\" data-kid=\"1-1-1-2\" data-name=\"navigation link list\">\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link inicio\" href=\"#\">\n                    Inicio\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link servicios\" href=\"#\">\n                    Servicios\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-1-2-3\" data-name=\"navigation link sobre la doctora\" href=\"#\">\n                    Sobre la Doctora\n                </a>\n                <a class=\"text-[#DE5D83] relative\" data-kid=\"1-1-1-2-4\" data-name=\"navigation link ubicación\" href=\"#\">\n                    Ubicación\n                    <span class=\"absolute -bottom-2 left-0 right-0 h-0.5 rounded-full bg-[#DE5D83]\" data-kid=\"1-1-1-2-4-1\" data-name=\"active tab underline\">\n                    </span>\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-1-2-5\" data-name=\"navigation link faq\" href=\"#\">\n                    FAQ\n                </a>\n            </nav>\n            <a class=\"nav-link inline-flex items-center gap-2 rounded-full bg-[#DE5D83] px-6 py-3 text-sm font-bold text-white shadow-[0_10px_24px_-8px_rgba(222,93,131,0.65)] hover:bg-[#c94e73]\" data-kid=\"1-1-1-3\" data-name=\"call to action schedule button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\" rel=\"noopener\" target=\"_blank\">\n                Agendar cita\n                <i class=\"ti ti-calendar-heart text-base\" data-kid=\"1-1-1-3-1\" data-name=\"calendar heart icon\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <!-- ═══════════ SPLIT: STICKY MAP + SCROLL PANEL ═══════════ -->\n    <section class=\"relative lg:grid lg:grid-cols-2\" data-kid=\"1-2\" data-name=\"split map and content section\">\n        <!-- Left: sticky map -->\n        <div class=\"relative\" data-kid=\"1-2-1\" data-name=\"sticky map container\">\n            <div class=\"lg:sticky lg:top-20 lg:h-[calc(100vh-5rem)] p-6 lg:p-8\" data-kid=\"1-2-1-1\" data-name=\"sticky map padding wrapper\">\n                <div class=\"relative h-[420px] lg:h-full w-full rounded-[2rem] overflow-hidden border border-[#DE5D83]/20 shadow-[0_24px_60px_-24px_rgba(222,93,131,0.35)] bg-white\" data-kid=\"1-2-1-1-1\" data-name=\"map frame container\" id=\"map-frame\">\n                    <div class=\"absolute inset-0 grid place-items-center bg-[#FDEEF3]\" data-kid=\"1-2-1-1-1-1\" data-name=\"map loading placeholder container\">\n                        <div class=\"text-center\" data-kid=\"1-2-1-1-1-1-1\" data-name=\"map pin icon container\">\n                            <span class=\"mx-auto grid h-14 w-14 place-items-center rounded-full bg-white text-[#DE5D83] text-3xl shadow-sm\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"map pin icon\">\n                                <i class=\"ti ti-map-pin\" data-kid=\"1-2-1-1-1-1-1-1-1\">\n                                </i>\n                            </span>\n                            <p class=\"mt-3 text-xs font-bold tracking-[0.2em] uppercase text-[#DE5D83]/70\" data-kid=\"1-2-1-1-1-1-1-2\">\n                                Cargando mapa…\n                            </p>\n                        </div>\n                    </div>\n                    <iframe allowfullscreen=\"\" class=\"absolute inset-0 h-full w-full\" data-kid=\"1-2-1-1-1-2\" data-name=\"google maps iframe\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://maps.google.com/maps?q=Doctors+Hospital+East+Auna+Guadalupe+Nuevo+Leon&t=&z=15&ie=UTF8&iwloc=&output=embed\" style=\"border:0\" title=\"Mapa — Doctors Hospital East Auna, Guadalupe, Nuevo León\">\n                    </iframe>\n                    <div class=\"absolute bottom-5 left-5 right-5 flex items-center gap-4 rounded-2xl bg-white/90 backdrop-blur-md px-5 py-4 border border-white shadow-lg\" data-kid=\"1-2-1-1-1-3\" data-name=\"map location badge\" id=\"map-badge\">\n                        <span class=\"grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#DE5D83] text-white text-xl\" data-kid=\"1-2-1-1-1-3-1\" data-name=\"map pin badge icon container\">\n                            <i class=\"ti ti-map-pin\" data-kid=\"1-2-1-1-1-3-1-1\" data-name=\"map pin badge icon\">\n                            </i>\n                        </span>\n                        <div class=\"min-w-0\" data-kid=\"1-2-1-1-1-3-2\" data-name=\"map location info container\">\n                            <p class=\"font-bold text-sm truncate\" data-kid=\"1-2-1-1-1-3-2-1\" data-name=\"location hospital name\">\n                                Doctors Hospital East Auna\n                            </p>\n                            <p class=\"text-xs text-[#3E2A33]/60 truncate\" data-kid=\"1-2-1-1-1-3-2-2\" data-name=\"location address detail\">\n                                Piso 12 · Consultorio 1225 · Guadalupe, N.L.\n                            </p>\n                        </div>\n                        <a class=\"ml-auto hidden sm:inline-flex items-center gap-1.5 rounded-full bg-[#3AA8C1]/10 px-4 py-2 text-xs font-bold text-[#3AA8C1] whitespace-nowrap\" data-kid=\"1-2-1-1-1-3-3\" data-name=\"get directions button\" href=\"https://www.google.com/maps?q=Doctors+Hospital+East+Auna+Guadalupe+Nuevo+Leon\" rel=\"noopener\" target=\"_blank\">\n                            Cómo llegar\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-1-1-1-3-3-1\" data-name=\"arrow up right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <!-- Right: scrollable white panel -->\n        <div class=\"relative bg-white lg:rounded-l-[3rem] border-l border-[#DE5D83]/10 px-6 py-14 lg:px-14 lg:py-20\" data-kid=\"1-2-2\" data-name=\"scrollable content panel\">\n            <div class=\"reveal\" data-kid=\"1-2-2-1\" data-name=\"introduction text container\">\n                <p class=\"text-xs font-bold tracking-[0.28em] uppercase text-[#3AA8C1]\" data-kid=\"1-2-2-1-1\" data-name=\"contact section label\">\n                    Contacto y ubicación\n                </p>\n                <h1 class=\"font-serif-d text-4xl lg:text-5xl mt-4 leading-[1.15]\" data-kid=\"1-2-2-1-2\" data-name=\"section hero headline\">\n                    Visítanos,\n                    <br data-kid=\"1-2-2-1-2-1\" data-name=\"line break\"/>\n                    <em class=\"text-[#DE5D83]\" data-kid=\"1-2-2-1-2-2\" data-name=\"emphasized hero text\">\n                        estamos para ti\n                    </em>\n                </h1>\n                <p class=\"mt-5 text-[#3E2A33]/65 leading-relaxed max-w-lg\" data-kid=\"1-2-2-1-3\" data-name=\"hero subheadline description\">\n                    Te esperamos en un espacio pensado para tu comodidad y privacidad, dentro de uno de los hospitales más modernos de la zona metropolitana de Monterrey.\n                </p>\n            </div>\n            <!-- Dirección destacada -->\n            <div class=\"reveal mt-9 relative rounded-2xl border border-[#3AA8C1]/25 bg-[#3AA8C1]/5 p-6 pl-8 overflow-hidden\" data-kid=\"1-2-2-2\" data-name=\"address highlight card\">\n                <span class=\"absolute left-0 top-0 bottom-0 w-1.5 bg-gradient-to-b from-[#3AA8C1] to-[#DE5D83]\" data-kid=\"1-2-2-2-1\" data-name=\"decorative color stripe\">\n                </span>\n                <p class=\"text-[11px] font-bold tracking-[0.22em] uppercase text-[#3AA8C1] mb-2\" data-kid=\"1-2-2-2-2\" data-name=\"address section label\">\n                    Dirección completa\n                </p>\n                <p class=\"font-serif-d text-xl\" data-kid=\"1-2-2-2-3\" data-name=\"hospital name heading\">\n                    Doctors Hospital East Auna\n                    <span class=\"text-[#DE5D83]\" data-kid=\"1-2-2-2-3-1\" data-name=\"clinic branding name\">\n                        (WOMEN&KIDS MC)\n                    </span>\n                </p>\n                <p class=\"mt-2 text-sm text-[#3E2A33]/70 leading-relaxed\" data-kid=\"1-2-2-2-4\" data-name=\"full address text\">\n                    Av. Prol. Francisco I. Madero 6060, Col. Libertad,\n                    <br class=\"hidden sm:block\" data-kid=\"1-2-2-2-4-1\" data-name=\"line break\"/>\n                    C.P. 67130, Guadalupe, Nuevo León, México\n                </p>\n                <p class=\"mt-4 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-xs font-bold text-[#3E2A33] border border-[#3AA8C1]/20\" data-kid=\"1-2-2-2-5\" data-name=\"floor info badge\">\n                    <i class=\"ti ti-building-hospital text-[#3AA8C1] text-base\" data-kid=\"1-2-2-2-5-1\" data-name=\"hospital building icon\">\n                    </i>\n                    Piso 12 · Consultorio 1225\n                </p>\n            </div>\n            <!-- CTAs de agendamiento -->\n            <div class=\"mt-12\" data-kid=\"1-2-2-3\" data-name=\"appointment call to action container\">\n                <div class=\"reveal flex items-baseline justify-between gap-4\" data-kid=\"1-2-2-3-1\" data-name=\"schedule header container\">\n                    <h2 class=\"font-serif-d text-2xl\" data-kid=\"1-2-2-3-1-1\" data-name=\"schedule section heading\">\n                        Agenda tu cita\n                    </h2>\n                    <span class=\"text-xs font-semibold text-[#3E2A33]/45\" data-kid=\"1-2-2-3-1-2\" data-name=\"schedule helper text\">\n                        3 vías directas · sin formularios\n                    </span>\n                </div>\n                <div class=\"mt-5 space-y-4\" data-kid=\"1-2-2-3-2\" data-name=\"appointment methods grid\">\n                    <a class=\"reveal group flex items-center gap-5 rounded-2xl bg-[#DE5D83] text-white p-5 shadow-[0_16px_36px_-14px_rgba(222,93,131,0.6)]\" data-kid=\"1-2-2-3-2-1\" data-name=\"doctoralia appointment button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\" rel=\"noopener\" target=\"_blank\">\n                        <span class=\"grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white/15 text-2xl\" data-kid=\"1-2-2-3-2-1-1\" data-name=\"calendar icon container\">\n                            <i class=\"ti ti-calendar-heart\" data-kid=\"1-2-2-3-2-1-1-1\" data-name=\"calendar heart icon\">\n                            </i>\n                        </span>\n                        <span class=\"flex-1 min-w-0\" data-kid=\"1-2-2-3-2-1-2\" data-name=\"doctoralia service name\">\n                            <span class=\"block font-bold\" data-kid=\"1-2-2-3-2-1-2-1\" data-name=\"main cta title\">\n                                Agendar en Doctoralia\n                            </span>\n                            <span class=\"block text-sm text-white/80 mt-0.5\" data-kid=\"1-2-2-3-2-1-2-2\" data-name=\"doctoralia rating text\">\n                                5.0 ⭐ · 763+ opiniones verificadas\n                            </span>\n                        </span>\n                        <i class=\"ti ti-arrow-up-right text-2xl opacity-80\" data-kid=\"1-2-2-3-2-1-3\" data-name=\"arrow icon\">\n                        </i>\n                    </a>\n                    <div class=\"reveal grid sm:grid-cols-2 gap-4\" data-kid=\"1-2-2-3-2-2\" data-name=\"other contact methods grid\">\n                        <a class=\"group rounded-2xl border border-[#3AA8C1]/30 bg-[#3AA8C1]/5 p-5\" data-kid=\"1-2-2-3-2-2-1\" data-name=\"whatsapp contact button\" href=\"https://wa.me/message/B7XHW6OWKLTDG1\" rel=\"noopener\" target=\"_blank\">\n                            <span class=\"flex items-center justify-between text-[#3AA8C1] text-2xl\" data-kid=\"1-2-2-3-2-2-1-1\" data-name=\"whatsapp icon and arrow container\">\n                                <i class=\"ti ti-brand-whatsapp\" data-kid=\"1-2-2-3-2-2-1-1-1\" data-name=\"whatsapp brand icon\">\n                                </i>\n                                <i class=\"ti ti-arrow-up-right text-lg opacity-60\" data-kid=\"1-2-2-3-2-2-1-1-2\" data-name=\"arrow icon\">\n                                </i>\n                            </span>\n                            <span class=\"block font-bold mt-3\" data-kid=\"1-2-2-3-2-2-1-2\" data-name=\"whatsapp button title\">\n                                WhatsApp Directo\n                            </span>\n                            <span class=\"block text-sm text-[#3E2A33]/60 mt-0.5\" data-kid=\"1-2-2-3-2-2-1-3\" data-name=\"whatsapp button subtitle\">\n                                Respuesta rápida en horario de consultorio\n                            </span>\n                        </a>\n                        <a class=\"group rounded-2xl border border-[#DE5D83]/25 bg-[#FFF5EE] p-5\" data-kid=\"1-2-2-3-2-2-2\" data-name=\"phone call contact button\" href=\"tel:+528127132300\">\n                            <span class=\"flex items-center justify-between text-[#DE5D83] text-2xl\" data-kid=\"1-2-2-3-2-2-2-1\" data-name=\"phone icon and arrow container\">\n                                <i class=\"ti ti-phone\" data-kid=\"1-2-2-3-2-2-2-1-1\" data-name=\"phone icon\">\n                                </i>\n                                <i class=\"ti ti-arrow-up-right text-lg opacity-60\" data-kid=\"1-2-2-3-2-2-2-1-2\" data-name=\"arrow icon\">\n       