      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  .font-serif-d { font-family: 'Playfair Display', serif; }\n  .font-body { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .gal-card { transition: transform .6s cubic-bezier(.22,1,.36,1), opacity .6s ease; }\n  .gal-dim { opacity: .55; transform: scale(.93); }\n  .faq-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .4s cubic-bezier(.22,1,.36,1); }\n  .faq-item.open .faq-body { grid-template-rows: 1fr; }\n  .faq-item.open .faq-bar { opacity: 1; }\n  .faq-item.open .faq-icon i { transform: rotate(45deg); }\n  .faq-icon i { display:inline-block; transition: transform .35s ease; }\n  .nav-link { transition: color .25s ease; }\n  .spiral-pink { filter: invert(58%) sepia(43%) saturate(1364%) hue-rotate(305deg) brightness(93%) contrast(88%); }\n</style>\n<div class=\"font-body bg-[#FFF5EE] text-[#4a3a3a]\" data-kid=\"1\" data-name=\"page layout container\" style=\"overflow-x: clip;\">\n    <!-- ============ HERO ============ -->\n    <section class=\"relative min-h-[92vh]\" data-kid=\"1-1\" data-name=\"hero section with gradient background\" id=\"inicio\" style=\"overflow: clip;\">\n        <div class=\"absolute inset-0 bg-[#FFF5EE]\" data-kid=\"1-1-1\" data-name=\"hero background layer\">\n        </div>\n        <div class=\"aurora-1 absolute -top-40 -left-40 w-[700px] h-[700px] rounded-full bg-[#DE5D83]/20 blur-[120px]\" data-kid=\"1-1-2\" data-name=\"aurora decorative blur\">\n        </div>\n        <div class=\"aurora-2 absolute top-20 right-0 w-[600px] h-[600px] rounded-full bg-[#3AA8C1]/15 blur-[120px]\" data-kid=\"1-1-3\" data-name=\"aurora decorative blur\">\n        </div>\n        <div class=\"aurora-3 absolute bottom-0 left-1/3 w-[500px] h-[500px] rounded-full bg-[#FFD9C4]/50 blur-[100px]\" data-kid=\"1-1-4\" data-name=\"aurora decorative blur\">\n        </div>\n        <!-- hero image, right offset (product-peek style) -->\n        <div class=\"absolute right-0 top-0 bottom-0 w-[54%] hidden md:block\" data-kid=\"1-1-5\" data-name=\"hero image container\">\n            <div class=\"absolute top-24 bottom-10 left-0 right-0 rounded-l-[3rem] overflow-hidden\" data-kid=\"1-1-5-1\" data-name=\"hero image wrapper\">\n                <img alt=\"Mujer embarazada sonriente — Pavel Danilyuk on Pexels\" class=\"w-full h-full object-cover\" data-kid=\"1-1-5-1-1\" data-name=\"hero image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7055815/pexels-photo-7055815.jpeg?auto=compress&cs=tinysrgb&w=1600&q=80\"/>\n                <div class=\"absolute inset-0 bg-gradient-to-r from-[#FFF5EE] via-[#FFF5EE]/25 to-transparent\" data-kid=\"1-1-5-1-2\" data-name=\"hero image gradient overlay\">\n                </div>\n                <div class=\"absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#FFF5EE] to-transparent\" data-kid=\"1-1-5-1-3\" data-name=\"hero image bottom gradient mask\">\n                </div>\n            </div>\n        </div>\n        <!-- Navbar -->\n        <header class=\"relative z-20 max-w-7xl mx-auto px-8 py-6 flex items-center justify-between\" data-kid=\"1-1-6\" data-name=\"main navigation bar\">\n            <a class=\"flex items-center gap-3\" data-kid=\"1-1-6-1\" data-name=\"logo link\" href=\"#inicio\">\n                <span class=\"w-10 h-10 rounded-full bg-gradient-to-br from-[#DE5D83] to-[#e98aa6] flex items-center justify-center text-white text-lg shadow-md shadow-[#DE5D83]/30\" data-kid=\"1-1-6-1-1\" data-name=\"logo icon container\">\n                    <i class=\"ti ti-heart-filled\" data-kid=\"1-1-6-1-1-1\" data-name=\"heart icon\">\n                    </i>\n                </span>\n                <span class=\"font-serif-d text-xl font-semibold tracking-wide text-[#3c2a2f]\" data-kid=\"1-1-6-1-2\" data-name=\"brand name text\">\n                    WOMEN\n                    <span class=\"text-[#DE5D83]\" data-kid=\"1-1-6-1-2-1\" data-name=\"brand name ampersand text\">\n                        &\n                    </span>\n                    KIDS\n                    <span class=\"text-[#3AA8C1]\" data-kid=\"1-1-6-1-2-2\" data-name=\"brand name acronym text\">\n                        MC\n                    </span>\n                </span>\n            </a>\n            <nav class=\"hidden lg:flex items-center gap-8 text-sm font-medium text-[#6d585e]\" data-kid=\"1-1-6-2\" data-name=\"navigation link list\">\n                <a class=\"nav-link text-[#DE5D83] font-semibold\" data-kid=\"1-1-6-2-1\" data-name=\"active navigation link\" href=\"#inicio\">\n                    Inicio\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-6-2-2\" data-name=\"navigation link\" href=\"#servicios\">\n                    Servicios\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-6-2-3\" data-name=\"navigation link\" href=\"#doctora\">\n                    Sobre la Doctora\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-6-2-4\" data-name=\"navigation link\" href=\"#ubicacion\">\n                    Ubicación\n                </a>\n                <a class=\"nav-link hover:text-[#DE5D83]\" data-kid=\"1-1-6-2-5\" data-name=\"navigation link\" href=\"#faq\">\n                    Preguntas Frecuentes\n                </a>\n            </nav>\n            <a class=\"rounded-full bg-[#DE5D83] text-white text-sm font-semibold px-6 py-3 shadow-lg shadow-[#DE5D83]/30 hover:bg-[#c94b70]\" data-kid=\"1-1-6-3\" data-name=\"primary call-to-action button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\" rel=\"noopener\" style=\"transition: background-color .25s ease;\" target=\"_blank\">\n                Agendar cita\n            </a>\n        </header>\n        <!-- Frosted panel -->\n        <div class=\"relative z-10 max-w-7xl mx-auto px-8 pt-14 pb-28\" data-kid=\"1-1-7\" data-name=\"hero panel container\">\n            <div class=\"max-w-xl backdrop-blur-md bg-white/45 border border-white/60 rounded-[2.5rem] rounded-tl-lg p-10 shadow-xl shadow-[#DE5D83]/10\" data-kid=\"1-1-7-1\" data-name=\"frosted hero panel\" id=\"heroPanel\">\n                <p class=\"flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#3AA8C1]\" data-kid=\"1-1-7-1-1\" data-name=\"hero subtitle line\">\n                    <span class=\"w-8 h-px bg-[#3AA8C1]\" data-kid=\"1-1-7-1-1-1\" data-name=\"decorative subtitle line\">\n                    </span>\n                    Ginecología & Obstetricia · Guadalupe, N.L.\n                </p>\n                <h1 class=\"font-serif-d text-[2.9rem] leading-[1.12] font-medium text-[#3c2a2f] mt-5\" data-kid=\"1-1-7-1-2\" data-name=\"hero headline text\">\n                    Cuidamos de ti y de tu bebé\n                    <em class=\"text-[#DE5D83]\" data-kid=\"1-1-7-1-2-1\" data-name=\"hero headline emphasized text\">\n                        en cada etapa\n                    </em>\n                </h1>\n                <p class=\"mt-5 text-base leading-relaxed text-[#6d585e]\" data-kid=\"1-1-7-1-3\" data-name=\"hero description text\">\n                    Acompañamiento ginecológico y obstétrico con calidez, empatía y medicina basada en evidencia. Desde tu chequeo anual hasta el control de embarazos de alto riesgo, estás en manos expertas.\n                </p>\n                <div class=\"mt-8 flex flex-wrap items-center gap-5\" data-kid=\"1-1-7-1-4\" data-name=\"hero button group\">\n                    <a class=\"rounded-full bg-[#DE5D83] text-white font-semibold px-8 py-4 shadow-lg shadow-[#DE5D83]/30 hover:bg-[#c94b70]\" data-kid=\"1-1-7-1-4-1\" data-name=\"primary call-to-action button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\" rel=\"noopener\" style=\"transition: background-color .25s ease;\" target=\"_blank\">\n                        Agenda tu cita hoy\n                    </a>\n                    <div class=\"flex items-center gap-2 text-sm text-[#6d585e]\" data-kid=\"1-1-7-1-4-2\" data-name=\"rating container\">\n                        <span class=\"text-[#f0a92e] text-base\" data-kid=\"1-1-7-1-4-2-1\" data-name=\"star icon container\">\n                            <i class=\"ti ti-star-filled\" data-kid=\"1-1-7-1-4-2-1-1\" data-name=\"star icon\">\n                            </i>\n                        </span>\n                        <span data-kid=\"1-1-7-1-4-2-2\" data-name=\"rating label text\">\n                            <strong class=\"text-[#3c2a2f]\" data-kid=\"1-1-7-1-4-2-2-1\" data-name=\"rating score text\">\n                                5.0\n                            </strong>\n                            · 763+ opiniones\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ BENTO AGENDAMIENTO ============ -->\n    <section class=\"relative z-20 pt-4 pb-24\" data-kid=\"1-2\" data-name=\"appointment options section\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"1-2-1\" data-name=\"appointment layout grid\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-5 lg:grid-rows-2 gap-5\" data-kid=\"1-2-1-1\" data-name=\"appointment grid items\">\n                <!-- Doctoralia (large) -->\n                <div class=\"bento-cell lg:col-span-3 lg:row-span-2 bg-white rounded-[2rem] border border-[#f3ded4] shadow-xl shadow-[#DE5D83]/8 p-9 flex flex-col justify-between\" data-kid=\"1-2-1-1-1\" data-name=\"doctoralia appointment card\">\n                    <div class=\"flex items-start justify-between gap-6\" data-kid=\"1-2-1-1-1-1\" data-name=\"doctoralia header section\">\n                        <div data-kid=\"1-2-1-1-1-1-1\" data-name=\"doctoralia text container\">\n                            <p class=\"text-xs font-bold tracking-[0.2em] uppercase text-[#DE5D83]\" data-kid=\"1-2-1-1-1-1-1-1\" data-name=\"doctoralia recommendation label\">\n                                Vía recomendada\n                            </p>\n                            <h3 class=\"font-serif-d text-3xl text-[#3c2a2f] mt-2\" data-kid=\"1-2-1-1-1-1-1-2\" data-name=\"doctoralia title\">\n                                Reserva en Doctoralia\n                            </h3>\n                            <p class=\"text-sm text-[#6d585e] mt-3 max-w-md leading-relaxed\" data-kid=\"1-2-1-1-1-1-1-3\" data-name=\"doctoralia description text\">\n                                Elige el horario que mejor te acomode y recibe confirmación inmediata. Perfil verificado de la Dra. Ahidé Valeria García Muñoz.\n                            </p>\n                        </div>\n                        <div class=\"shrink-0 text-center bg-[#FFF5EE] rounded-2xl px-5 py-4 border border-[#f3ded4]\" data-kid=\"1-2-1-1-1-1-2\" data-name=\"doctoralia rating box\">\n                            <p class=\"text-3xl font-bold text-[#3c2a2f]\" data-kid=\"1-2-1-1-1-1-2-1\" data-name=\"doctoralia rating score\">\n                                5.0\n                            </p>\n                            <p class=\"text-[#f0a92e] text-sm tracking-tight\" data-kid=\"1-2-1-1-1-1-2-2\" data-name=\"doctoralia star rating icon\">\n                                ★★★★★\n                            </p>\n                            <p class=\"text-[11px] text-[#6d585e] mt-1\" data-kid=\"1-2-1-1-1-1-2-3\" data-name=\"doctoralia review count\">\n                                763+ opiniones\n                                <br data-kid=\"1-2-1-1-1-1-2-3-1\" data-name=\"line break\"/>\n                                verificadas\n                            </p>\n                        </div>\n                    </div>\n                    <a class=\"mt-8 w-full inline-flex items-center justify-center gap-2 rounded-full bg-[#DE5D83] text-white font-semibold px-8 py-4 shadow-lg shadow-[#DE5D83]/30 hover:bg-[#c94b70]\" data-kid=\"1-2-1-1-1-2\" data-name=\"doctoralia booking button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\" rel=\"noopener\" target=\"_blank\">\n                        <i class=\"ti ti-calendar-check\" data-kid=\"1-2-1-1-1-2-1\" data-name=\"calendar check icon\">\n                        </i>\n                        Agendar en Doctoralia\n                    </a>\n                </div>\n                <!-- WhatsApp -->\n                <a class=\"bento-cell lg:col-span-2 bg-[#e6f4f8] border border-[#3AA8C1]/25 rounded-[2rem] p-7 flex items-center gap-5 hover:border-[#3AA8C1]/60\" data-kid=\"1-2-1-1-2\" data-name=\"whatsapp appointment card\" href=\"https://wa.me/message/B7XHW6OWKLTDG1\" rel=\"noopener\" target=\"_blank\">\n                    <span class=\"w-14 h-14 rounded-2xl bg-[#3AA8C1] text-white flex items-center justify-center text-2xl shrink-0 shadow-md shadow-[#3AA8C1]/30\" data-kid=\"1-2-1-1-2-1\" data-name=\"whatsapp icon container\">\n                        <i class=\"ti ti-message-circle\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"whatsapp icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-1-1-2-2\" data-name=\"whatsapp text container\">\n                        <h3 class=\"font-serif-d text-xl text-[#234b56]\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"whatsapp title\">\n                            WhatsApp Directo\n                        </h3>\n                        <p class=\"text-sm text-[#3f6a75] mt-1\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"whatsapp description\">\n                            Escríbenos y agenda en minutos\n                            <i class=\"ti ti-arrow-up-right\" data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </p>\n                    </div>\n                </a>\n                <!-- Llamada -->\n                <a class=\"bento-cell lg:col-span-2 bg-white border border-[#f3ded4] rounded-[2rem] p-7 flex items-center gap-5 hover:border-[#DE5D83]/50\" data-kid=\"1-2-1-1-3\" data-name=\"phone appointment card\" href=\"tel:+528127132300\">\n                    <span class=\"w-14 h-14 rounded-2xl bg-[#FFF5EE] border border-[#f3ded4] text-[#DE5D83] flex items-center justify-center text-2xl shrink-0\" data-kid=\"1-2-1-1-3-1\" data-name=\"phone icon container\">\n                        <i class=\"ti ti-phone\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"phone icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-2-1-1-3-2\" data-name=\"phone text container\">\n                        <h3 class=\"font-serif-d text-xl text-[#3c2a2f]\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"phone title\">\n                            Llamar al consultorio\n                        </h3>\n                        <p class=\"text-sm text-[#6d585e] mt-1 font-semibold\" data-kid=\"1-2-1-1-3-2-2\" data-name=\"phone number text\">\n                            +52 81 2713 2300\n                        </p>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- ============ SOBRE LA DOCTORA ============ -->\n    <section class=\"py-16\" data-kid=\"1-3\" data-name=\"about doctor section\" id=\"doctora\">\n        <div class=\"max-w-7xl mx-auto px-8 grid lg:grid-cols-12 gap-14 items-center\" data-kid=\"1-3-1\" data-name=\"about doctor layout grid\">\n            <div class=\"lg:col-span-5 relative\" data-kid=\"1-3-1-1\" data-name=\"doctor image gallery\">\n                <div class=\"absolute -top-8 -left-8 w-40 h-40 rounded-full bg-[#3AA8C1]/15 blur-2xl\" data-kid=\"1-3-1-1-1\" data-name=\"decorative blur\">\n                </div>\n                <div class=\"absolute -bottom-10 -right-6 w-52 h-52 rounded-full bg-[#DE5D83]/15 blur-2xl\" data-kid=\"1-3-1-1-2\" data-name=\"decorative blur\">\n                </div>\n                <div class=\"relative rounded-[60%_40%_30%_70%/60%_30%_70%_40%] overflow-hidden border-8 border-white shadow-2xl shadow-[#DE5D83]/15 aspect-[4/5]\" data-kid=\"1-3-1-1-3\" data-name=\"doctor photo shape wrapper\">\n                    <img alt=\"Doctora sonriente — AI25.Studio Studio on Pexels\" class=\"w-full h-[115%] object-cover will-change-transform\" data-kid=\"1-3-1-1-3-1\" data-name=\"doctor photo\" decoding=\"async\" id=\"doctorImg\" loading=\"lazy\" src=\"https://images.pexels.com/photos/6749765/pexels-photo-6749765.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                </div>\n                <div class=\"absolute -bottom-3 right-8 bg-white rounded-2xl shadow-lg border border-[#f3ded4] px-5 py-3 flex items-center gap-3\" data-kid=\"1-3-1-1-4\" data-name=\"doctor rating overlay\">\n                    <span class=\"text-[#f0a92e] text-xl\" data-kid=\"1-3-1-1-4-1\" data-name=\"star icon container\">\n                        <i class=\"ti ti-star-filled\" data-kid=\"1-3-1-1-4-1-1\" data-name=\"star icon\">\n                        </i>\n                    </span>\n                    <div data-kid=\"1-3-1-1-4-2\" data-name=\"rating text container\">\n                        <p class=\"font-bold text-[#3c2a2f] leading-none\" data-kid=\"1-3-1-1-4-2-1\" data-name=\"rating score\">\n                            5.0\n                        </p>\n                        <p class=\"text-[11px] text-[#6d585e]\" data-kid=\"1-3-1-1-4-2-2\" data-name=\"rating count\">\n                            763+ opiniones\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <div class=\"lg:col-span-7\" data-kid=\"1-3-1-2\" data-name=\"about doctor text section\">\n                <p class=\"flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#3AA8C1]\" data-kid=\"1-3-1-2-1\" data-name=\"about subtitle line\">\n                    <span class=\"w-8 h-px bg-[#3AA8C1]\" data-kid=\"1-3-1-2-1-1\" data-name=\"decorative subtitle line\">\n                    </span>\n                    Sobre la Doctora\n                </p>\n                <h2 class=\"font-serif-d text-4xl text-[#3c2a2f] mt-4\" data-kid=\"1-3-1-2-2\" data-name=\"doctor name\">\n                    Dra. Ahidé Valeria García Muñoz\n                </h2>\n                <div class=\"mt-4 flex flex-wrap gap-2\" data-kid=\"1-3-1-2-3\" data-name=\"doctor credentials tags container\">\n                    <span class=\"rounded-full bg-[#DE5D83]/10 text-[#c14568] text-xs font-semibold px-4 py-2\" data-kid=\"1-3-1-2-3-1\" data-name=\"credential tag\">\n                        Ginecología y Obstetricia\n                    </span>\n                    <span class=\"rounded-full bg-[#3AA8C1]/10 text-[#2b7f93] text-xs font-semibold px-4 py-2\" data-kid=\"1-3-1-2-3-2\" data-name=\"credential tag\">\n                        Medicina Crítica Obstétrica\n                    </span>\n                    <span class=\"rounded-full bg-white border border-[#f3ded4] text-[#6d585e] text-xs font-semibold px-4 py-2\" data-kid=\"1-3-1-2-3-3\" data-name=\"credential tag\">\n                        Cédulas 8566406 · 6062822\n                    </span>\n                </div>\n                <p class=\"mt-6 text-[#6d585e] leading-relaxed\" data-kid=\"1-3-1-2-4\" data-name=\"doctor bio text\">\n                    Comprometida con la salud integral de la mujer en todas sus etapas: desde el chequeo de rutina y la salud sexual y reproductiva, hasta el control prenatal de bajo y alto riesgo. Cada consulta se vive con escucha, respeto y decisiones informadas, respaldadas por la mejor evidencia médica disponible.\n                </p>\n                <div class=\"relative mt-8 bg-white border border-[#f3ded4] rounded-2xl p-7 pl-9\" data-kid=\"1-3-1-2-5\" data-name=\"doctor quote container\">\n                    <span class=\"absolute left-0 top-0 bottom-0 w-1.5 rounded-l-2xl bg-gradient-to-b from-[#3AA8C1] to-[#DE5D83]\" data-kid=\"1-3-1-2-5-1\" data-name=\"quote decorative border line\">\n                    </span>\n                    <p class=\"font-serif-d italic text-lg text-[#3c2a2f] leading-relaxed\" data-kid=\"1-3-1-2-5-2\" data-name=\"quote text\">\n                        “Mi compromiso es ofrecerte una atención cálida, empática y basada en evidencia, para que tú y tu bebé se sientan seguras en cada paso.”\n                    </p>\n                    <p class=\"mt-3 text-xs font-bold tracking-[0.2em] uppercase text-[#DE5D83]\" data-kid=\"1-3-1-2-5-3\" data-name=\"quote author name\">\n                        — Dra. Valeria García\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ SERVICIOS ============ -->\n    <section class=\"py-20\" data-kid=\"1-4\" data-name=\"services section\" id=\"servicios\">\n        <div class=\"max-w-7xl mx-auto px-8\" data-kid=\"1-4-1\" data-name=\"services content container\">\n            <div class=\"max-w-3xl\" data-kid=\"1-4-1-1\" data-name=\"services header section\">\n                <p class=\"flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#DE5D83]\" data-kid=\"1-4-1-1-1\" data-name=\"services subtitle\">\n                    <span class=\"w-8 h-px bg-[#DE5D83]\" data-kid=\"1-4-1-1-1-1\" data-name=\"decorative subtitle line\">\n                    </span>\n                    Servicios\n                </p>\n                <h2 class=\"font-serif-d text-4xl text-[#3c2a2f] mt-4\" data-kid=\"1-4-1-1-2\" data-name=\"services title\">\n                    Cuidado integral para cada etapa de tu vida\n                </h2>\n            </div>\n            <div class=\"mt-14 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-12\" data-kid=\"1-4-1-2\" data-name=\"services list\">\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-1\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#DE5D83]/10 text-[#DE5D83] flex items-center justify-center text-3xl group-hover:bg-[#DE5D83] group-hover:text-white\" data-kid=\"1-4-1-2-1-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-stethoscope\" data-kid=\"1-4-1-2-1-1-1\" data-name=\"stethoscope icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-1-2\" data-name=\"service name\">\n                        Consulta Ginecológica y Chequeo Anual\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-2\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#3AA8C1]/10 text-[#3AA8C1] flex items-center justify-center text-3xl group-hover:bg-[#3AA8C1] group-hover:text-white\" data-kid=\"1-4-1-2-2-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-baby-carriage\" data-kid=\"1-4-1-2-2-1-1\" data-name=\"baby carriage icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-2-2\" data-name=\"service name\">\n                        Control Prenatal y Embarazo de Alto y Bajo Riesgo\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-3\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#DE5D83]/10 text-[#DE5D83] flex items-center justify-center text-3xl group-hover:bg-[#DE5D83] group-hover:text-white\" data-kid=\"1-4-1-2-3-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-device-heart-monitor\" data-kid=\"1-4-1-2-3-1-1\" data-name=\"heart monitor icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-3-2\" data-name=\"service name\">\n                        Ultrasonido Obstétrico\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-4\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#3AA8C1]/10 text-[#3AA8C1] flex items-center justify-center text-3xl group-hover:bg-[#3AA8C1] group-hover:text-white\" data-kid=\"1-4-1-2-4-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-microscope\" data-kid=\"1-4-1-2-4-1-1\" data-name=\"microscope icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-4-2\" data-name=\"service name\">\n                        Papanicolaou y Detección Oportuna\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-5\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#3AA8C1]/10 text-[#3AA8C1] flex items-center justify-center text-3xl group-hover:bg-[#3AA8C1] group-hover:text-white\" data-kid=\"1-4-1-2-5-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-vaccine\" data-kid=\"1-4-1-2-5-1-1\" data-name=\"vaccine icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-5-2\" data-name=\"service name\">\n                        Vacunación contra el VPH\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-6\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#DE5D83]/10 text-[#DE5D83] flex items-center justify-center text-3xl group-hover:bg-[#DE5D83] group-hover:text-white\" data-kid=\"1-4-1-2-6-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-calendar-heart\" data-kid=\"1-4-1-2-6-1-1\" data-name=\"calendar heart icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-6-2\" data-name=\"service name\">\n                        Planificación Familiar y Métodos Anticonceptivos\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-7\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#3AA8C1]/10 text-[#3AA8C1] flex items-center justify-center text-3xl group-hover:bg-[#3AA8C1] group-hover:text-white\" data-kid=\"1-4-1-2-7-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-flower\" data-kid=\"1-4-1-2-7-1-1\" data-name=\"flower icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-7-2\" data-name=\"service name\">\n                        Control Hormonal y Menopausia\n                    </h3>\n                </div>\n                <div class=\"svc-item text-center group\" data-kid=\"1-4-1-2-8\" data-name=\"service item\">\n                    <span class=\"mx-auto w-20 h-20 rounded-full bg-[#DE5D83]/10 text-[#DE5D83] flex items-center justify-center text-3xl group-hover:bg-[#DE5D83] group-hover:text-white\" data-kid=\"1-4-1-2-8-1\" data-name=\"service icon container\" style=\"transition: background-color .3s ease, color .3s ease;\">\n                        <i class=\"ti ti-heartbeat\" data-kid=\"1-4-1-2-8-1-1\" data-name=\"heartbeat icon\">\n                        </i>\n                    </span>\n                    <h3 class=\"mt-4 font-semibold text-sm text-[#3c2a2f] leading-snug\" data-kid=\"1-4-1-2-8-2\" data-name=\"service name\">\n                        Quistes Ováricos y Patologías Ginecológicas\n                    </h3>\n                </div>\n            </div>\n            <div class=\"mt-12 flex justify-end border-t border-[#f3ded4] pt-6\" data-kid=\"1-4-1-3\" data-name=\"view all services footer\">\n                <a class=\"inline-flex items-center gap-2 text-sm font-semibold text-[#DE5D83] hover:text-[#c94b70]\" data-kid=\"1-4-1-3-1\" data-name=\"view all services link\" href=\"#servicios\" style=\"transition: color .25s ease;\">\n                    Ver todos los servicios\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-4-1-3-1-1\" data-name=\"right arrow icon\">\n                    </i>\n                </a>\n            </div>\n        </div>\n    </section>\n    <!-- ============ GALERÍA ============ -->\n    <section class=\"py-20\" data-kid=\"1-5\" data-name=\"gallery section\" id=\"galeria\" style=\"overflow-x: clip;\">\n        <div class=\"max-w-7xl mx-auto px-8 flex flex-wrap items-end justify-between gap-6\" data-kid=\"1-5-1\" data-name=\"gallery header\">\n            <div data-kid=\"1-5-1-1\" data-name=\"gallery title container\">\n                <p class=\"flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#3AA8C1]\" data-kid=\"1-5-1-1-1\" data-name=\"gallery subtitle\">\n                    <span class=\"w-8 h-px bg-[#3AA8C1]\" data-kid=\"1-5-1-1-1-1\" data-name=\"decorative subtitle line\">\n                    </span>\n                    Nuestro consultorio\n                </p>\n                <h2 class=\"font-serif-d text-4xl text-[#3c2a2f] mt-4\" data-kid=\"1-5-1-1-2\" data-name=\"gallery title\">\n                    Un espacio pensado para tu comodidad\n                </h2>\n            </div>\n            <div class=\"flex gap-3\" data-kid=\"1-5-1-2\" data-name=\"carousel controls\">\n                <button aria-label=\"Anterior\" class=\"w-12 h-12 rounded-full bg-white border border-[#f3ded4] text-[#3c2a2f] hover:border-[#DE5D83] text-lg\" data-kid=\"1-5-1-2-1\" data-name=\"previous slide button\" id=\"galPrev\" style=\"transition: border-color .25s ease;\">\n                    <i class=\"ti ti-arrow-left\" data-kid=\"1-5-1-2-1-1\" data-name=\"left arrow icon\">\n                    </i>\n                </button>\n                <button aria-label=\"Siguiente\" class=\"w-12 h-12 rounded-full bg-[#DE5D83] text-white text-lg shadow-lg shadow-[#DE5D83]/30 hover:bg-[#c94b70]\" data-kid=\"1-5-1-2-2\" data-name=\"next slide button\" id=\"galNext\" style=\"transition: background-color .25s ease;\">\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-5-1-2-2-1\" data-name=\"right arrow icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n        <div class=\"mt-12\" data-dynamic=\"true\" data-kid=\"1-5-2\" data-name=\"gallery carousel track\" data-reason=\"inline style transform updated by JS to scroll images\">\n            <div class=\"flex gap-6 will-change-transform\" data-kid=\"1-5-2-1\" data-name=\"gallery carousel items\" id=\"galTrack\" style=\"transition: transform .65s cubic-bezier(.22,1,.36,1); padding-left: calc(50vw - 260px);\">\n                <article class=\"gal-card shrink-0 w-[520px] max-w-[86vw] rounded-[2rem] overflow-hidden relative bg-white shadow-xl shadow-[#3c2a2f]/10\" data-kid=\"1-5-2-1-1\" data-name=\"gallery image card\">\n                    <img alt=\"Consultorio cómodo y minimalista — Ivan Babydov on Pexels\" class=\"w-full h-[340px] object-cover\" data-kid=\"1-5-2-1-1-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7789616/pexels-photo-7789616.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#3c2a2f]/75 via-transparent to-transparent\" data-kid=\"1-5-2-1-1-2\" data-name=\"image gradient overlay\">\n                    </div>\n                    <span class=\"absolute top-5 left-6 text-[11px] font-bold tracking-[0.18em] uppercase text-white/90 bg-white/20 backdrop-blur-xs rounded-full px-4 py-1.5\" data-kid=\"1-5-2-1-1-3\" data-name=\"image index label\">\n                        01\n                    </span>\n                    <p class=\"absolute bottom-5 left-6 text-white font-serif-d text-2xl\" data-kid=\"1-5-2-1-1-4\" data-name=\"image title text\">\n                        Ambiente cómodo\n                    </p>\n                </article>\n                <article class=\"gal-card gal-dim shrink-0 w-[520px] max-w-[86vw] rounded-[2rem] overflow-hidden relative bg-white shadow-xl shadow-[#3c2a2f]/10\" data-kid=\"1-5-2-1-2\" data-name=\"gallery image card\">\n                    <img alt=\"Sala privada de consulta — Pavel Danilyuk on Pexels\" class=\"w-full h-[340px] object-cover\" data-kid=\"1-5-2-1-2-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7108390/pexels-photo-7108390.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#3c2a2f]/75 via-transparent to-transparent\" data-kid=\"1-5-2-1-2-2\" data-name=\"image gradient overlay\">\n                    </div>\n                    <span class=\"absolute top-5 left-6 text-[11px] font-bold tracking-[0.18em] uppercase text-white/90 bg-white/20 backdrop-blur-xs rounded-full px-4 py-1.5\" data-kid=\"1-5-2-1-2-3\" data-name=\"image index label\">\n                        02\n                    </span>\n                    <p class=\"absolute bottom-5 left-6 text-white font-serif-d text-2xl\" data-kid=\"1-5-2-1-2-4\" data-name=\"image title text\">\n                        Privacidad total\n                    </p>\n                </article>\n                <article class=\"gal-card gal-dim shrink-0 w-[520px] max-w-[86vw] rounded-[2rem] overflow-hidden relative bg-white shadow-xl shadow-[#3c2a2f]/10\" data-kid=\"1-5-2-1-3\" data-name=\"gallery image card\">\n                    <img alt=\"Sala de espera elegante — Kate Filatova on Pexels\" class=\"w-full h-[340px] object-cover\" data-kid=\"1-5-2-1-3-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/30784399/pexels-photo-30784399.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#3c2a2f]/75 via-transparent to-transparent\" data-kid=\"1-5-2-1-3-2\" data-name=\"image gradient overlay\">\n                    </div>\n                    <span class=\"absolute top-5 left-6 text-[11px] font-bold tracking-[0.18em] uppercase text-white/90 bg-white/20 backdrop-blur-xs rounded-full px-4 py-1.5\" data-kid=\"1-5-2-1-3-3\" data-name=\"image index label\">\n                        03\n                    </span>\n                    <p class=\"absolute bottom-5 left-6 text-white font-serif-d text-2xl\" data-kid=\"1-5-2-1-3-4\" data-name=\"image title text\">\n                        Instalaciones modernas\n                    </p>\n                </article>\n                <article class=\"gal-card gal-dim shrink-0 w-[520px] max-w-[86vw] rounded-[2rem] overflow-hidden relative bg-white shadow-xl shadow-[#3c2a2f]/10\" data-kid=\"1-5-2-1-4\" data-name=\"gallery image card\">\n                    <img alt=\"Clínica moderna y luminosa — Ivan Babydov on Pexels\" class=\"w-full h-[340px] object-cover\" data-kid=\"1-5-2-1-4-1\" data-name=\"gallery image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/7789602/pexels-photo-7789602.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-[#3c2a2f]/75 via-transparent to-transparent\" data-kid=\"1-5-2-1-4-2\" data-name=\"image gradient overlay\">\n                    </div>\n                    <span class=\"absolute top-5 left-6 text-[11px] font-bold tracking-[0.18em] uppercase text-white/90 bg-white/20 backdrop-blur-xs rounded-full px-4 py-1.5\" data-kid=\"1-5-2-1-4-3\" data-name=\"image index label\">\n                        04\n                    </span>\n                    <p class=\"absolute bottom-5 left-6 text-white font-serif-d text-2xl\" data-kid=\"1-5-2-1-4-4\" data-name=\"image title text\">\n                        Equipo médico actualizado\n                    </p>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FAQ ============ -->\n    <section class=\"py-20\" data-kid=\"1-6\" data-name=\"faq section\" id=\"faq\">\n        <div class=\"max-w-7xl mx-auto px-8 grid lg:grid-cols-12 gap-14\" data-kid=\"1-6-1\" data-name=\"faq content grid\">\n            <div class=\"lg:col-span-5\" data-kid=\"1-6-1-1\" data-name=\"faq sidebar container\">\n                <div class=\"lg:sticky lg:top-24\" data-kid=\"1-6-1-1-1\" data-name=\"faq content wrapper\">\n                    <p class=\"flex items-center gap-2 text-xs font-bold tracking-widest uppercase text-[#DE5D83]\" data-kid=\"1-6-1-1-1-1\" data-name=\"faq subtitle\">\n                        <span class=\"w-8 h-px bg-[#DE5D83]\" data-kid=\"1-6-1-1-1-1-1\" data-name=\"decorative subtitle line\">\n                        </span>\n                        Preguntas Frecuentes\n                    </p>\n                    <h2 class=\"font-serif-d text-5xl text-[#3c2a2f] mt-4 leading-tight\" data-kid=\"1-6-1-1-1-2\" data-name=\"faq section title\">\n                        Resolvemos\n                        <br data-kid=\"1-6-1-1-1-2-1\" data-name=\"line break\"/>\n                        tus dudas\n                    </h2>\n                    <p class=\"mt-4 text-[#6d585e] max-w-sm\" data-kid=\"1-6-1-1-1-3\" data-name=\"faq description text\">\n                        ¿No encuentras tu respuesta? Escríbenos por WhatsApp y con gusto te atendemos.\n                    </p>\n                    <a class=\"mt-6 inline-flex items-center gap-2 rounded-full border border-[#3AA8C1]/40 bg-[#e6f4f8] text-[#2b7f93] text-sm font-semibold px-6 py-3 hover:border-[#3AA8C1]\" data-kid=\"1-6-1-1-1-4\" data-name=\"faq whatsapp contact button\" href=\"https://wa.me/message/B7XHW6OWKLTDG1\" rel=\"noopener\" style=\"transition: border-color .25s ease;\" target=\"_blank\">\n                        <i class=\"ti ti-message-circle\" data-kid=\"1-6-1-1-1-4-1\" data-name=\"whatsapp icon\">\n                        </i>\n                        WhatsApp Directo\n                    </a>\n                    <img alt=\"\" class=\"spiral-pink mt-10 w-24 opacity-70\" data-kid=\"1-6-1-1-1-5\" data-name=\"decorative spiral icon\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/spiral-arrow.svg\"/>\n                </div>\n            </div>\n            <div class=\"lg:col-span-7 space-y-4\" data-kid=\"1-6-1-2\" data-name=\"faq accordion container\">\n                <div class=\"faq-item open relative bg-white rounded-2xl border border-[#f3ded4] overflow-hidden\" data-kid=\"1-6-1-2-1\" data-name=\"faq item\">\n                    <span class=\"faq-bar absolute left-0 top-0 bottom-0 w-1 bg-[#3AA8C1] opacity-0\" data-kid=\"1-6-1-2-1-1\" data-name=\"active indicator bar\" style=\"transition: opacity .3s ease;\">\n                    </span>\n                    <button class=\"faq-btn w-full flex items-center justify-between gap-4 text-left px-7 py-5\" data-kid=\"1-6-1-2-1-2\" data-name=\"faq toggle button\">\n                        <span class=\"font-semibold text-[#3c2a2f]\" data-kid=\"1-6-1-2-1-2-1\" data-name=\"faq question text\">\n                            ¿Cómo puedo agendar una cita?\n                        </span>\n                        <span class=\"faq-icon text-[#DE5D83] text-xl shrink-0\" data-kid=\"1-6-1-2-1-2-2\" data-name=\"faq icon container\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-6-1-2-1-2-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"faq-body\" data-kid=\"1-6-1-2-1-3\" data-name=\"faq body wrapper\">\n                        <div class=\"overflow-hidden\" data-kid=\"1-6-1-2-1-3-1\" data-name=\"faq answer wrapper\">\n                            <p class=\"px-7 pb-6 text-sm text-[#6d585e] leading-relaxed\" data-kid=\"1-6-1-2-1-3-1-1\" data-name=\"faq answer text\">\n                                Tienes 3 vías disponibles: reservar en línea a través de\n                                <strong class=\"text-[#3c2a2f]\" data-kid=\"1-6-1-2-1-3-1-1-1\" data-name=\"bold emphasis text\">\n                                    Doctoralia\n                                </strong>\n                                , enviarnos un mensaje por\n                                <strong class=\"text-[#3c2a2f]\" data-kid=\"1-6-1-2-1-3-1-1-2\" data-name=\"bold emphasis text\">\n                                    WhatsApp\n                                </strong>\n                                o\n                                <strong class=\"text-[#3c2a2f]\" data-kid=\"1-6-1-2-1-3-1-1-3\" data-name=\"bold emphasis text\">\n                                    llamar\n                                </strong>\n                                directamente al consultorio al +52 81 2713 2300.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"faq-item relative bg-white rounded-2xl border border-[#f3ded4] overflow-hidden\" data-kid=\"1-6-1-2-2\" data-name=\"faq item\">\n                    <span class=\"faq-bar absolute left-0 top-0 bottom-0 w-1 bg-[#3AA8C1] opacity-0\" data-kid=\"1-6-1-2-2-1\" data-name=\"active indicator bar\" style=\"transition: opacity .3s ease;\">\n                    </span>\n                    <button class=\"faq-btn w-full flex items-center justify-between gap-4 text-left px-7 py-5\" data-kid=\"1-6-1-2-2-2\" data-name=\"faq toggle button\">\n                        <span class=\"font-semibold text-[#3c2a2f]\" data-kid=\"1-6-1-2-2-2-1\" data-name=\"faq question text\">\n                            ¿Dónde está ubicado el consultorio?\n                        </span>\n                        <span class=\"faq-icon text-[#DE5D83] text-xl shrink-0\" data-kid=\"1-6-1-2-2-2-2\" data-name=\"faq icon container\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-6-1-2-2-2-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"faq-body\" data-kid=\"1-6-1-2-2-3\" data-name=\"faq body wrapper\">\n                        <div class=\"overflow-hidden\" data-kid=\"1-6-1-2-2-3-1\" data-name=\"faq answer wrapper\">\n                            <p class=\"px-7 pb-6 text-sm text-[#6d585e] leading-relaxed\" data-kid=\"1-6-1-2-2-3-1-1\" data-name=\"faq answer text\">\n                                En\n                                <strong class=\"text-[#3c2a2f]\" data-kid=\"1-6-1-2-2-3-1-1-1\" data-name=\"bold emphasis text\">\n                                    Doctors Hospital East Auna\n                                </strong>\n                                , Av. Prol. Francisco I. Madero 6060, Col. Libertad, C.P. 67130, Guadalupe, Nuevo León — Piso 12, Consultorio 1225.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"faq-item relative bg-white rounded-2xl border border-[#f3ded4] overflow-hidden\" data-kid=\"1-6-1-2-3\" data-name=\"faq item\">\n                    <span class=\"faq-bar absolute left-0 top-0 bottom-0 w-1 bg-[#3AA8C1] opacity-0\" data-kid=\"1-6-1-2-3-1\" data-name=\"active indicator bar\" style=\"transition: opacity .3s ease;\">\n                    </span>\n                    <button class=\"faq-btn w-full flex items-center justify-between gap-4 text-left px-7 py-5\" data-kid=\"1-6-1-2-3-2\" data-name=\"faq toggle button\">\n                        <span class=\"font-semibold text-[#3c2a2f]\" data-kid=\"1-6-1-2-3-2-1\" data-name=\"faq question text\">\n                            ¿Qué documentos debo llevar?\n                        </span>\n                        <span class=\"faq-icon text-[#DE5D83] text-xl shrink-0\" data-kid=\"1-6-1-2-3-2-2\" data-name=\"faq icon container\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-6-1-2-3-2-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"faq-body\" data-kid=\"1-6-1-2-3-3\" data-name=\"faq body wrapper\">\n                        <div class=\"overflow-hidden\" data-kid=\"1-6-1-2-3-3-1\" data-name=\"faq answer wrapper\">\n                            <p class=\"px-7 pb-6 text-sm text-[#6d585e] leading-relaxed\" data-kid=\"1-6-1-2-3-3-1-1\" data-name=\"faq answer text\">\n                                Te recomendamos traer una identificación oficial y, si cuentas con ellos, tus estudios previos (ultrasonidos, laboratorios, papanicolaou) para dar continuidad a tu historial médico.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"faq-item relative bg-white rounded-2xl border border-[#f3ded4] overflow-hidden\" data-kid=\"1-6-1-2-4\" data-name=\"faq item\">\n                    <span class=\"faq-bar absolute left-0 top-0 bottom-0 w-1 bg-[#3AA8C1] opacity-0\" data-kid=\"1-6-1-2-4-1\" data-name=\"active indicator bar\" style=\"transition: opacity .3s ease;\">\n                    </span>\n                    <button class=\"faq-btn w-full flex items-center justify-between gap-4 text-left px-7 py-5\" data-kid=\"1-6-1-2-4-2\" data-name=\"faq toggle button\">\n                        <span class=\"font-semibold text-[#3c2a2f]\" data-kid=\"1-6-1-2-4-2-1\" data-name=\"faq question text\">\n                            ¿Aceptan pagos con tarjeta?\n                        </span>\n                        <span class=\"faq-icon text-[#DE5D83] text-xl shrink-0\" data-kid=\"1-6-1-2-4-2-2\" data-name=\"faq icon container\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-6-1-2-4-2-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"faq-body\" data-kid=\"1-6-1-2-4-3\" data-name=\"faq body wrapper\">\n                        <div class=\"overflow-hidden\" data-kid=\"1-6-1-2-4-3-1\" data-name=\"faq answer wrapper\">\n                            <p class=\"px-7 pb-6 text-sm text-[#6d585e] leading-relaxed\" data-kid=\"1-6-1-2-4-3-1-1\" data-name=\"faq answer text\">\n                                Sí. Aceptamos\n                                <strong class=\"text-[#3c2a2f]\" data-kid=\"1-6-1-2-4-3-1-1-1\" data-name=\"bold emphasis text\">\n                                    efectivo, transferencia bancaria y tarjetas de débito y crédito\n                                </strong>\n                                para tu comodidad.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"faq-item relative bg-white rounded-2xl border border-[#f3ded4] overflow-hidden\" data-kid=\"1-6-1-2-5\" data-name=\"faq item\">\n                    <span class=\"faq-bar absolute left-0 top-0 bottom-0 w-1 bg-[#3AA8C1] opacity-0\" data-kid=\"1-6-1-2-5-1\" data-name=\"active indicator bar\" style=\"transition: opacity .3s ease;\">\n                    </span>\n                    <button class=\"faq-btn w-full flex items-center justify-between gap-4 text-left px-7 py-5\" data-kid=\"1-6-1-2-5-2\" data-name=\"faq toggle button\">\n                        <span class=\"font-semibold text-[#3c2a2f]\" data-kid=\"1-6-1-2-5-2-1\" data-name=\"faq question text\">\n                            ¿Atienden urgencias?\n                        </span>\n                        <span class=\"faq-icon text-[#DE5D83] text-xl shrink-0\" data-kid=\"1-6-1-2-5-2-2\" data-name=\"faq icon container\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-6-1-2-5-2-2-1\" data-name=\"plus icon\">\n                            </i>\n                        </span>\n                    </button>\n                    <div class=\"faq-body\" data-kid=\"1-6-1-2-5-3\" data-name=\"faq body wrapper\">\n                        <div class=\"overflow-hidden\" data-kid=\"1-6-1-2-5-3-1\" data-name=\"faq answer wrapper\">\n                            <p class=\"px-7 pb-6 text-sm text-[#6d585e] leading-relaxed\" data-kid=\"1-6-1-2-5-3-1-1\" data-name=\"faq answer text\">\n                                Sí, en caso de urgencia comunícate directamente al consultorio al\n                                <a class=\"text-[#DE5D83] font-semibold\" data-kid=\"1-6-1-2-5-3-1-1-1\" data-name=\"phone number link\" href=\"tel:+528127132300\">\n                                    +52 81 2713 2300\n                                </a>\n                                para recibir indicaciones inmediatas. Los domingos se atiende previa cita.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ============ FOOTER ============ -->\n    <footer class=\"mt-10 bg-[#432e35] text-[#e9d6cd] rounded-t-[3rem] relative\" data-kid=\"1-7\" data-name=\"footer section\" id=\"ubicacion\" style=\"overflow: clip;\">\n        <div class=\"absolute -top-32 right-10 w-[400px] h-[400px] rounded-full bg-[#DE5D83]/20 blur-[100px]\" data-kid=\"1-7-1\" data-name=\"footer decorative blur\">\n        </div>\n        <div class=\"absolute bottom-0 -left-20 w-[350px] h-[350px] rounded-full bg-[#3AA8C1]/10 blur-[100px]\" data-kid=\"1-7-2\" data-name=\"footer decorative blur\">\n        </div>\n        <div class=\"max-w-7xl mx-auto px-8 pt-16 pb-8 relative\" data-kid=\"1-7-3\" data-name=\"footer content wrapper\">\n            <!-- banner -->\n            <div class=\"relative flex flex-col lg:flex-row items-center justify-between gap-8 bg-white/5 border border-white/10 rounded-[2rem] p-10 backdrop-blur-xs\" data-kid=\"1-7-3-1\" data-name=\"footer banner card\" style=\"overflow: clip;\">\n                <div class=\"absolute -top-20 -left-16 w-[320px] h-[320px] rounded-full bg-[#DE5D83]/25 blur-[90px] pointer-events-none\" data-kid=\"1-7-3-1-1\" data-name=\"decorative blur\">\n                </div>\n                <div class=\"absolute -bottom-24 right-24 w-[300px] h-[300px] rounded-full bg-[#3AA8C1]/15 blur-[90px] pointer-events-none\" data-kid=\"1-7-3-1-2\" data-name=\"decorative blur\">\n                </div>\n                <h2 class=\"relative font-serif-d text-3xl text-white text-center lg:text-left\" data-kid=\"1-7-3-1-3\" data-name=\"footer banner title\">\n                    Tu salud es lo más importante.\n                    <br data-kid=\"1-7-3-1-3-1\" data-name=\"line break\"/>\n                    <span class=\"text-[#f0a1ba]\" data-kid=\"1-7-3-1-3-2\" data-name=\"colored emphasis text\">\n                        Déjanos acompañarte.\n                    </span>\n                </h2>\n                <div class=\"relative flex flex-wrap justify-center gap-4\" data-kid=\"1-7-3-1-4\" data-name=\"footer banner buttons\">\n                    <a class=\"rounded-full bg-[#DE5D83] text-white font-semibold px-7 py-4 shadow-lg shadow-[#DE5D83]/30 hover:bg-[#c94b70]\" data-kid=\"1-7-3-1-4-1\" data-name=\"call-to-action button\" href=\"https://www.doctoralia.com.mx/ahide-valeria-garcia-munoz/ginecologo/nuevo-leon\" rel=\"noopener\" style=\"transition: background-color .25s ease;\" target=\"_blank\">\n                        Agendar en Doctoralia\n                    </a>\n                    <a class=\"inline-flex items-center gap-2 rounded-full border border-white/25 text-white font-semibold px-7 py-4 hover:bg-white/10\" data-kid=\"1-7-3-1-4-2\" data-name=\"whatsapp button\" href=\"https://wa.me/message/B7XHW6OWKLTDG1\" rel=\"noopener\" style=\"transition: background-color .25s ease;\" target=\"_blank\">\n                        <i class=\"ti ti-message-circle\" data-kid=\"1-7-3-1-4-2-1\" data-name=\"whatsapp icon\">\n                        </i>\n                        WhatsApp\n                    </a>\n                </div>\n            </div>\n            <!-- columns -->\n            <div class=\"mt-14 grid md:grid-cols-2 lg:grid-cols-4 gap-10 text-sm\" data-kid=\"1-7-3-2\" data-name=\"footer links container\">\n                <div data-kid=\"1-7-3-2-1\" data-name=\"brand info column\">\n                    <p class=\"font-serif-d text-xl text-white\" data-kid=\"1-7-3-2-1-1\" data-name=\"brand name\">\n                        WOMEN\n                        <span class=\"text-[#f0a1ba]\" data-kid=\"1-7-3-2-1-1-1\" data-name=\"brand ampersand\">\n                          