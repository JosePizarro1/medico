                <a class=\"hover:text-white\" data-kid=\"1-7-3-2-2-2-5-1\" data-name=\"link\" href=\"#faq\" style=\"transition: color .25s ease;\">\n                                Preguntas Frecuentes\n                            </a>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-7-3-2-3\" data-name=\"contact column\">\n                    <p class=\"text-xs font-bold tracking-[0.2em] uppercase text-[#f0a1ba]\" data-kid=\"1-7-3-2-3-1\" data-name=\"column header\">\n                        Contacto\n                    </p>\n                    <ul class=\"mt-4 space-y-3 text-[#cdb4ab]\" data-kid=\"1-7-3-2-3-2\" data-name=\"contact link list\">\n                        <li class=\"flex gap-3\" data-kid=\"1-7-3-2-3-2-1\" data-name=\"contact info item\">\n                            <span class=\"text-[#7fcbdd]\" data-kid=\"1-7-3-2-3-2-1-1\" data-name=\"phone icon container\">\n                                <i class=\"ti ti-phone\" data-kid=\"1-7-3-2-3-2-1-1-1\" data-name=\"phone icon\">\n                                </i>\n                            </span>\n                            <a class=\"hover:text-white\" data-kid=\"1-7-3-2-3-2-1-2\" data-name=\"phone number link\" href=\"tel:+528127132300\" style=\"transition: color .25s ease;\">\n                                +52 81 2713 2300\n                            </a>\n                        </li>\n                        <li class=\"flex gap-3\" data-kid=\"1-7-3-2-3-2-2\" data-name=\"contact info item\">\n                            <span class=\"text-[#7fcbdd]\" data-kid=\"1-7-3-2-3-2-2-1\" data-name=\"location icon container\">\n                                <i class=\"ti ti-map-pin\" data-kid=\"1-7-3-2-3-2-2-1-1\" data-name=\"location icon\">\n                                </i>\n                            </span>\n                            <span data-kid=\"1-7-3-2-3-2-2-2\" data-name=\"address text\">\n                                Doctors Hospital East Auna, Av. Prol. Francisco I. Madero 6060, Col. Libertad, C.P. 67130, Guadalupe, N.L. — Piso 12, Consultorio 1225\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n                <div data-kid=\"1-7-3-2-4\" data-name=\"hours column\">\n                    <p class=\"text-xs font-bold tracking-[0.2em] uppercase text-[#f0a1ba]\" data-kid=\"1-7-3-2-4-1\" data-name=\"column header\">\n                        Horarios\n                    </p>\n                    <ul class=\"mt-4 space-y-2.5 text-[#cdb4ab]\" data-kid=\"1-7-3-2-4-2\" data-name=\"hours list\">\n                        <li class=\"flex justify-between gap-4\" data-kid=\"1-7-3-2-4-2-1\" data-name=\"weekday row\">\n                            <span data-kid=\"1-7-3-2-4-2-1-1\" data-name=\"label text\">\n                                Lun – Vie\n                            </span>\n                            <span class=\"text-white\" data-kid=\"1-7-3-2-4-2-1-2\" data-name=\"time text\">\n                                09:00 – 19:00\n                            </span>\n                        </li>\n                        <li class=\"flex justify-between gap-4\" data-kid=\"1-7-3-2-4-2-2\" data-name=\"weekday row\">\n                            <span data-kid=\"1-7-3-2-4-2-2-1\" data-name=\"label text\">\n                                Sábado\n                            </span>\n                            <span class=\"text-white\" data-kid=\"1-7-3-2-4-2-2-2\" data-name=\"time text\">\n                                10:00 – 13:30\n                            </span>\n                        </li>\n                        <li class=\"flex justify-between gap-4\" data-kid=\"1-7-3-2-4-2-3\" data-name=\"weekday row\">\n                            <span data-kid=\"1-7-3-2-4-2-3-1\" data-name=\"label text\">\n                                Domingo\n                            </span>\n                            <span class=\"text-white text-right\" data-kid=\"1-7-3-2-4-2-3-2\" data-name=\"status text\">\n                                Urgencias previa cita\n                            </span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            <div class=\"mt-12 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-3 text-xs text-[#b39a91]\" data-kid=\"1-7-3-3\" data-name=\"footer bottom bar\">\n                <p data-kid=\"1-7-3-3-1\" data-name=\"copyright text\">\n                    © 2025 WOMEN&KIDS MC — Dra. Ahidé Valeria García Muñoz. Todos los derechos reservados.\n                </p>\n                <p data-kid=\"1-7-3-3-2\" data-name=\"license text\">\n                    Cédulas profesionales 8566406 · 6062822\n                </p>\n            </div>\n        </div>\n    </footer>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  // Hero frosted panel: blur-in entrance\n  gsap.from(\"#heroPanel\", { autoAlpha: 0, y: 28, filter: \"blur(12px)\", duration: 0.9, ease: \"power2.out\", delay: 0.15 });\n\n  // Aurora gradient gentle shift on scroll\n  gsap.to(\".aurora-1\", { xPercent: 12, yPercent: 10, scrollTrigger: { trigger: \"#inicio\", start: \"top top\", end: \"bottom top\", scrub: 1.2 } });\n  gsap.to(\".aurora-2\", { xPercent: -10, yPercent: 14, scrollTrigger: { trigger: \"#inicio\", start: \"top top\", end: \"bottom top\", scrub: 1.2 } });\n  gsap.to(\".aurora-3\", { xPercent: 8, yPercent: -12, scrollTrigger: { trigger: \"#inicio\", start: \"top top\", end: \"bottom top\", scrub: 1.2 } });\n\n  // Bento cells: staggered batch reveal\n  gsap.set(\".bento-cell\", { autoAlpha: 0, y: 32 });\n  ScrollTrigger.batch(\".bento-cell\", {\n    start: \"top 88%\",\n    interval: 0.08,\n    onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, duration: 0.55, stagger: 0.09, ease: \"power2.out\", overwrite: true })\n  });\n\n  // Service items: batch reveal\n  gsap.set(\".svc-item\", { autoAlpha: 0, y: 26 });\n  ScrollTrigger.batch(\".svc-item\", {\n    start: \"top 88%\",\n    interval: 0.08,\n    batchMax: 8,\n    onEnter: (els) => gsap.to(els, { autoAlpha: 1, y: 0, duration: 0.5, stagger: 0.06, ease: \"power2.out\", overwrite: true })\n  });\n\n  // Doctor portrait: gentle parallax (image moves slower)\n  gsap.fromTo(\"#doctorImg\", { yPercent: -10 }, { yPercent: 0, ease: \"none\",\n    scrollTrigger: { trigger: \"#doctora\", start: \"top bottom\", end: \"bottom top\", scrub: 1 } });\n\n  // Gallery carousel\n  (function () {\n    const track = document.getElementById(\"galTrack\");\n    const cards = Array.from(track.querySelectorAll(\".gal-card\"));\n    let idx = 0;\n    function render() {\n      const step = cards[0].offsetWidth + 24; // gap-6 = 24px\n      track.style.transform = \"translateX(\" + (-idx * step) + \"px)\";\n      cards.forEach((c, i) => c.classList.toggle(\"gal-dim\", i !== idx));\n    }\n    document.getElementById(\"galNext\").addEventListener(\"click\", () => { idx = (idx + 1) % cards.length; render(); });\n    document.getElementById(\"galPrev\").addEventListener(\"click\", () => { idx = (idx - 1 + cards.length) % cards.length; render(); });\n    window.addEventListener(\"resize\", render);\n  })();\n\n  // FAQ accordion\n  document.querySelectorAll(\".faq-btn\").forEach((btn) => {\n    btn.addEventListener(\"click\", () => {\n      const item = btn.closest(\".faq-item\");\n      const wasOpen = item.classList.contains(\"open\");\n      document.querySelectorAll(\".faq-item.open\").forEach((el) => el.classList.remove(\"open\"));\n      if (!wasOpen) item.classList.add(\"open\");\n    });\n  });\n</script>\n",
      "comments": [],
